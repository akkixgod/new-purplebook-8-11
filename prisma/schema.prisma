generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String    @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  role                     String    @default("user")
  createdAt                DateTime  @default(now())
  accounts                 Account[]
  sessions                 Session[]
  attempts                 Attempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Test {
  id        String   @id @default(cuid())
  title     String
  year      Int
  month     Int
  section   String   // "MATH" | "ENGLISH"
  version   String?  // e.g. "US Form B", "International Form A"
  isFree    Boolean  @default(true)
  createdAt DateTime @default(now())
  modules   Module[]
}

model Module {
  id          String     @id @default(cuid())
  testId      String
  number      Int        // 1 or 2
  timeLimit   Int        @default(1920) // seconds (32 min default)
  test        Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    Attempt[]

  @@index([testId])
  @@index([testId, number])
}

model Question {
  id            String   @id @default(cuid())
  moduleId      String
  order         Int
  stimulus      String?  // passage/context shown in left panel (English questions)
  text          String   // the actual question prompt
  imageUrl      String?
  choices       String   // JSON: { A: string, B: string, C: string, D: string }
  correctAnswer String   // "A" | "B" | "C" | "D"
  explanation   String?
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@index([moduleId])
  @@index([moduleId, order])
}

model Attempt {
  id              String    @id @default(cuid())
  userId          String?
  moduleId        String
  claimToken      String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  score           Int?
  totalQuestions  Int?
  timeSpent       Int?      // seconds
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  answers         Answer[]

  @@index([userId])
  @@index([moduleId])
  @@index([userId, moduleId])
  @@index([finishedAt])
  @@index([claimToken])
}

model Answer {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  selected    String?  // "A" | "B" | "C" | "D" | null (skipped)
  isCorrect   Boolean
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}
