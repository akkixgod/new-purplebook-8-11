DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth v5. Prefer AUTH_SECRET. Keep AUTH_SECRET and NEXTAUTH_SECRET in sync.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Do not hardcode AUTH_URL / NEXTAUTH_URL for local dev. Auth.js rewrites the
# request origin to that value, which breaks sign-in when the app is not on
# that host/port (e.g. localhost:3011 vs localhost:3000).
# Production (Vercel) should set AUTH_URL / NEXTAUTH_URL to the public origin.
# AUTH_URL="https://your-production-domain"
# NEXTAUTH_URL="https://your-production-domain"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Desmos calculator API (optional). Demo key is used if unset.
# Get a production key at https://www.desmos.com/my-api
NEXT_PUBLIC_DESMOS_API_KEY=""

# SVGMaker MCP — get a key at https://svgmaker.io/account
# Also set the same value in .cursor/mcp.json → mcpServers.svgmaker.env.SVGMAKER_API_KEY
SVGMAKER_API_KEY=""
