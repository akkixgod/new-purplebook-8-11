DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — password reset emails (https://resend.com/api-keys)
# Leave RESEND_API_KEY empty for local testing: the reset URL is printed in the
# Next.js server terminal and returned as `devResetUrl` in the API error response.
RESEND_API_KEY=""
EMAIL_FROM="PurpleBook <onboarding@resend.dev>"

# SVGMaker MCP — get a key at https://svgmaker.io/account
# Also set the same value in .cursor/mcp.json → mcpServers.svgmaker.env.SVGMAKER_API_KEY
SVGMAKER_API_KEY=""
