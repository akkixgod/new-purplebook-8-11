DATABASE_URL="file:./dev.db"

# Production (Vercel) — REQUIRED for durable practice history across serverless isolates.
# Without these, attempts can appear to save then vanish after refresh / sign-in / new deploy.
# Create a free DB at https://app.turso.tech then set both on the Vercel project (Production).
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"
# Optional belt-and-suspenders (Vercel already refuses ephemeral /tmp without Turso/remote):
# REQUIRE_DURABLE_DB="1"
# Destructive catalog reseed against Turso (cascade-wipes attempts) — leave unset in prod:
# ALLOW_PROD_SEED_WIPE="1"

# Auth.js / NextAuth v5. Prefer AUTH_SECRET. Keep AUTH_SECRET and NEXTAUTH_SECRET in sync.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Do not hardcode AUTH_URL / NEXTAUTH_URL for local dev. Auth.js rewrites the
# request origin to that value, which breaks sign-in when the app is not on
# that host/port (e.g. localhost:3011 vs localhost:3000).
# Production (Vercel) should set AUTH_URL / NEXTAUTH_URL to the public origin.
# AUTH_URL="https://your-production-domain"
# NEXTAUTH_URL="https://your-production-domain"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Desmos calculator API (optional). Demo key is used if unset.
# Get a production key at https://www.desmos.com/my-api
NEXT_PUBLIC_DESMOS_API_KEY=""

# SVGMaker MCP — get a key at https://svgmaker.io/account
# Also set the same value in .cursor/mcp.json → mcpServers.svgmaker.env.SVGMAKER_API_KEY
SVGMAKER_API_KEY=""
